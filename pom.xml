<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ibm.cics.cip.bank</groupId>
    <artifactId>cics-banking-sample-application</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>
    <name>CBSA</name>

    <properties>
        <java.version>17</java.version>
    </properties>

    <!--
        The IBM CICS Transaction Server BOM (com.ibm.cics:com.ibm.cics.ts.bom)
        was removed as part of the mainframe decommission (AAP Section 3.7).
        The target is a standalone, pure-Java/PostgreSQL application: no module
        in this reactor depends on CICS-, JZOS-, or WebSphere-managed
        coordinates, so the reactor no longer imports any mainframe dependency
        management. Each module manages its own dependency versions (bank-core
        via the Spring Boot parent BOM; the remaining modules explicitly).
    -->

    <modules>
        <module>src/bank-core</module>
        <module>src/Z-OS-Connect-Customer-Services-Interface</module>
        <module>src/Z-OS-Connect-Payment-Interface</module>
        <module>src/webui</module>
    </modules>


</project>
