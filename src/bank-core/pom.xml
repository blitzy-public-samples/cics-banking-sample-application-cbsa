<!--
  Maven build descriptor for the standalone bank-core module.

  This module is the pure-Java, Spring Boot reimplementation of the CBSA
  (Bank Sample Application) COBOL banking core. It runs on Spring Boot 3.5.11
  (Java 17) with embedded Tomcat and is backed by PostgreSQL via Spring Data
  JPA / Hibernate, with Flyway managing the relational schema.

  It is a clean, mainframe-free module: it deliberately carries none of the
  legacy IBM mainframe libraries or bundle-packaging plugins, and it builds a
  plain runnable JAR. Dependency versions are resolved by the Spring Boot
  parent BOM (no explicit <version> element on the starters or the Flyway
  artifacts); the PostgreSQL JDBC driver version is pinned via the
  <postgresql.version> property to take the CVE-2026-42198 security fix (the
  3.5.11 BOM otherwise manages it to the vulnerable 42.7.10 - see <properties>).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>


	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.11</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>


	<groupId>com.ibm.cics.cip.bank</groupId>
	<artifactId>bank-core</artifactId>
	<version>1.0</version>
	<packaging>jar</packaging>
	<name>bank-core</name>
	<description>Standalone Spring Boot reimplementation of the CBSA COBOL banking core, backed by PostgreSQL</description>


	<properties>
		<java.version>17</java.version>
		<!--
			Pin the PostgreSQL JDBC driver to 42.7.11, overriding the version
			the Spring Boot 3.5.11 BOM would otherwise manage (42.7.10).
			pgJDBC releases from 42.2.0 up to (but excluding) 42.7.11 are
			vulnerable to CVE-2026-42198 - a client-side SCRAM-SHA-256
			denial of service in which a malicious server can force unbounded
			PBKDF2 iteration counts; 42.7.11 is the security fix release.
			spring-boot-starter-parent honours this well-known version
			property when resolving org.postgresql:postgresql.
		-->
		<postgresql.version>42.7.11</postgresql.version>
	</properties>


	<dependencies>

		<!-- REST controllers + embedded Tomcat (replaces the legacy Liberty / z/OS Connect runtime). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- Spring Data JPA + Hibernate (replaces the legacy file-control / embedded Db2 SQL data path). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Jakarta Bean Validation (BMS field rules -> annotations, F-021). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- PostgreSQL JDBC driver (replaces VSAM / Db2). Runtime-only: not needed at compile time. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Schema-migration engine (net-new; materializes the relational schema). -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>

		<!-- Flyway PostgreSQL support module. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- JUnit 5, Mockito, Spring Test (service parity + controller contract tests). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>


	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!--
				Surefire test inclusion. Maven Surefire's default includes are
				**/Test*.java, **/*Test.java, **/*Tests.java and
				**/*TestCase.java, which EXCLUDE the controller contract tests
				named *IT.java. The frozen z/OS Connect REST contract (F-019)
				is guarded by those *ControllerIT slices, so they must run as
				part of the default `mvn clean package` build rather than only
				when explicitly selected. The slices are pure @WebMvcTest
				(no PostgreSQL, no Testcontainers), so running them with the
				unit tests under Surefire is safe and keeps the baseline build
				command green end to end. Surefire (not Failsafe) is used
				because the baseline command is `package`; Failsafe binds to
				the later integration-test/verify phases. Declaring <includes>
				replaces the default set, so the four defaults are restated
				alongside **/*IT.java. The plugin version is managed by the
				Spring Boot parent BOM.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/Test*.java</include>
						<include>**/*Test.java</include>
						<include>**/*Tests.java</include>
						<include>**/*TestCase.java</include>
						<include>**/*IT.java</include>
					</includes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
